pipeline {
    agent any
    
    environment {
        HARBOR_REGISTRY = '192.168.5.234'
        PROJECT_NAME    = 'my-portfolio'
        IMAGE_NAME      = 'my-portfolio'
        CREDENTIALS_ID  = 'harbor-creds'
        
        // Explicit tags jo aapne bataye
        TAG_VERSION     = "${BUILD_NUMBER}"
        TAG_LATEST      = "latest"
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Deploy to Server') {
            steps {
                // Yeh hai asli CD ka code jo Harbor se image pull karke server ki IP par port 8081 par chalayega
                sh '''
                    echo "Deploying to server on port 8081 using explicit latest tag..."
                    
                    // Purana container hata dein agar pehle se chal raha ho
                    sudo docker stop portfolio-container || true
                    sudo docker rm portfolio-container || true
                    
                    // Harbor se image pull karein
                    sudo docker pull ${HARBOR_REGISTRY}/${PROJECT_NAME}/${IMAGE_NAME}:${TAG_LATEST}
                    
                    // Naya container port 8081 par run karein
                    sudo docker run -d --name portfolio-container -p 8081:80 --restart always ${HARBOR_REGISTRY}/${PROJECT_NAME}/${IMAGE_NAME}:${TAG_LATEST}
                '''
            }
        }
    }
}